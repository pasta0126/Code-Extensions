{
  "name": "kanban-json",
  "displayName": "Kanban JSON",
  "description": "Editor de tableros Kanban para ficheros kanban.json, con vista de texto.",
  "version": "0.0.2",
  "publisher": "pasta0126",
  "icon": "icon.png",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/pasta0126/Code-Extensions.git",
    "directory": "extensions/kanban-json"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "kanbanJson.board",
        "displayName": "Kanban",
        "selector": [
          {
            "filenamePattern": "kanban.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "kanbanJson.createBoard",
        "title": "Kanban: Crear kanban.json de ejemplo"
      },
      {
        "command": "kanbanJson.openAsText",
        "title": "Kanban: Abrir como texto"
      },
      {
        "command": "kanbanJson.openAsBoard",
        "title": "Kanban: Abrir como tablero"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
