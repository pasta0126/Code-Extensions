{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run kanban-json",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/kanban-json",
        "${workspaceFolder}/extensions/kanban-json/examples"
      ],
      "outFiles": ["${workspaceFolder}/extensions/kanban-json/dist/**/*.js"],
      "preLaunchTask": "kanban-json: build"
    }
  ]
}
